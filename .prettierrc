{
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "auto",
    "objectWrap": "preserve",
    "printWidth": 140,
    "proseWrap": "preserve",
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "es5",
    "overrides": [
        {
            "files": "*.json",
            "options": {
                "parser": "json",
                "printWidth": 1
            }
        }
    ]
}
